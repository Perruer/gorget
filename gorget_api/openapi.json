    "/metrics": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "summary": "Read Metrics",
        "operationId": "read_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
