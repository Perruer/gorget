          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/analyze/conversation": {
      "post": {
        "tags": [
          "Analyze"
        ],
        "summary": "Submit Analyze Conversation",
        "description": "Scan a chat history: the latest user message, recent messages together, tool results and, when enabled, the risk accumulated over the conversation",
        "operationId": "submit_analyze_conversation_analyze_conversation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeConversationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeConversationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/scan/conversation": {
      "post": {
        "tags": [
          "Analyze"
        ],
        "summary": "Submit Scan Conversation",
        "description": "Same checks as /analyze/conversation without the sanitized prompt",
        "operationId": "submit_scan_conversation_scan_conversation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
